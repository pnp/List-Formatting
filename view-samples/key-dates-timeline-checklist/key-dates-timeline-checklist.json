          "height": "10px",
          "border-radius": "50%",
          "background-color": "#03274a",
          "z-index": "2",
          "border": "2px solid #ffffff",
          "box-shadow": "0 0 0 1px #03274a"
        }
      },
      {
        "elmType": "div",
        "style": {
          "position": "absolute",
          "top": "42px",
          "left": "46px",
          "width": "2px",
          "height": "68px",
          "background-color": "#03274a"
        }
      },
      {
        "elmType": "div",
        "style": {
          "position": "absolute",
          "top": "110px",
          "left": "-100px",
          "width": "230px",
          "height": "1px",
          "background-color": "#c8c6c4"
        }
      },
      {
        "elmType": "div",
        "style": {
          "position": "absolute",
          "top": "72px",
          "left": "20px",
          "right": "16px",
          "height": "8px",
          "background-color": "#EDEBE9",
          "border-radius": "999px",
          "overflow": "hidden"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "width": "= (if([$Process1Status]=='Completed',1,0) + if([$Process2Status]=='Completed',1,0) + if([$Process3Status]=='Completed',1,0) + if([$Process4Status]=='Completed',1,0) + if([$Process5Status]=='Completed',1,0)) / (if([$Process1], 1, 0) + if([$Process2], 1, 0) + if([$Process3], 1, 0) + if([$Process4], 1, 0) + if([$Process5], 1, 0)) * 100 + '%'",
              "height": "100%",
              "background-color": "#107C10",
              "border-radius": "999px",
              "transition": "width 0.35s ease"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "= (if([$Process1Status]=='Completed',1,0) + if([$Process2Status]=='Completed',1,0) + if([$Process3Status]=='Completed',1,0) + if([$Process4Status]=='Completed',1,0) + if([$Process5Status]=='Completed',1,0)) + '/' + (if([$Process1], 1, 0) + if([$Process2], 1, 0) + if([$Process3], 1, 0) + if([$Process4], 1, 0) + if([$Process5], 1, 0)) + ' completed'",
        "style": {
          "position": "absolute",
          "top": "84px",
          "left": "20px",
          "font-size": "11px",
          "color": "#605E5C",
          "font-weight": "600"

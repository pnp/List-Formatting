                      "font-size": "13px",
                      "color": "#323130",
                      "white-space": "pre-wrap",
                      "line-height": "1.45"
                    }
                  },
                  {
                    "elmType": "a",
                    "attributes": {
                      "href": "[$Process1Link]",
                      "target": "=if([$Process1Link]=='','', '_blank')"

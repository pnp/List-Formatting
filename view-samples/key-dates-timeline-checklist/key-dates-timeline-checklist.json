                      "background-color": "#03274a",
                      "padding": "6px 14px",
                      "border-radius": "4px",
                      "color": "white",
                      "text-decoration": "none",
                      "align-self": "flex-start",
                      "font-size": "13px",
                      "font-weight": "600",
                      "pointer-events": "=if([$Process1Link]=='','none','auto')"
                    },

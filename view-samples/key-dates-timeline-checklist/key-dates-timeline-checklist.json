        "children": [
          {
            "elmType": "div",
            "style": {
              "display": "=if([$Process1] == '', 'none', 'flex')",
              "flex-direction": "row",
              "align-items": "flex-start",
              "gap": "10px",
              "padding": "8px 6px",
              "border-radius": "6px",
              "cursor": "pointer",
              "background-color": "=if([$Process1Status]=='Completed', '#F3F9F1', 'transparent')"
            },
            "customRowAction": {
              "action": "setValue",
              "actionInput": {
                "Process1Status": "=if([$Process1Status]=='Completed', 'Not started', 'Completed')"
              }
            },
            "customCardProps": {
              "formatter": {
                "elmType": "div",
                "style": {
                  "display": "flex",
                  "flex-direction": "column",
                  "gap": "12px",
                  "width": "300px",
                  "padding": "16px",

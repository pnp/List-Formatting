{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideColumnHeader": true,
  "hideSelection": true,
  "rowFormatter": {
    "elmType": "div",
    "style": {
      "position": "absolute",
      "left": "= @rowIndex * 230 + 'px'",
      "width": "200px",
      "height": "540px",
      "font-family": "Segoe UI",
      "top": "20px",
      "display": "block",
      "min-height": "500px",
      "margin-bottom": "40px",
      "padding": "0 8px"
    },
    "children": [
      {
        "elmType": "div",
        "txtContent": "[$Month]",
        "style": {
          "padding": "4px 0",
          "position": "absolute",
          "top": "0px",
          "left": "28px",
          "font-size": "15px",
          "font-weight": "700",
          "color": "#03274A",
          "letter-spacing": "0.2px"
        }
      },
      {
        "elmType": "div",
        "style": {
          "position": "absolute",
          "top": "32px",
          "left": "42px",

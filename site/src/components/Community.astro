---
import { CalendarDays, CirclePlay, ArrowUpRight } from '@lucide/astro';
---
<aside class="community-ribbon" aria-label="Learn with the community">
  <div class="container community-inner">
    <CalendarDays size={23} aria-hidden="true" />
    <p><strong>Better together.</strong> Learn, ask questions, and share what you've built.</p>
    <a href="https://aka.ms/community/calls">Community calls <ArrowUpRight size={15} aria-hidden="true" /></a>
    <a href="https://aka.ms/community/youtube"><CirclePlay size={19} aria-hidden="true" /> Watch &amp; learn</a>
  </div>
</aside>
